{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kawa/1mark/schemas/prediction.schema.json",
  "title": "Prediction record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "protocol_version", "task_id", "status", "synthetic"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "protocol_version": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["PRE", "WAIT", "SKIP", "UNAVAILABLE", "INCOMPLETE"]},
    "synthetic": {"type": "boolean"},
    "evidence_ids": {"type": "array", "items": {"type": "string"}},
    "reason": {"type": "string", "minLength": 1},
    "missing": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "prediction": {"$ref": "#/$defs/prediction"},
    "change_conditions": {
      "type": "array", "minItems": 1,
      "items": {"type": "object", "additionalProperties": false,
        "required": ["condition", "effect"],
        "properties": {"condition": {"type": "string", "minLength": 1}, "effect": {"type": "string", "minLength": 1}}}
    },
    "risk_management": {
      "type": "object", "additionalProperties": false,
      "required": ["finalized", "bets"],
      "properties": {
        "finalized": {"type": "boolean"},
        "bets": {
          "type": "array", "minItems": 1,
          "items": {"type": "object", "additionalProperties": false,
            "required": ["market", "selection", "odds", "units"],
            "properties": {
              "market": {"type": "string", "minLength": 1},
              "selection": {"type": "string", "minLength": 1},
              "odds": {"type": "number", "exclusiveMinimum": 1},
              "units": {"type": "number", "exclusiveMinimum": 0}
            }}
        }
      }
    }
  },
  "$defs": {
    "prediction": {
      "type": "object", "additionalProperties": false,
      "required": ["outcome", "probability", "rationale"],
      "properties": {
        "outcome": {"type": "string", "minLength": 1},
        "probability": {"type": "number", "minimum": 0, "maximum": 1},
        "rationale": {"type": "string", "minLength": 1}
      }
    }
  },
  "allOf": [
    {"if": {"properties": {"status": {"const": "PRE"}}},
     "then": {"required": ["prediction", "risk_management"],
       "properties": {"risk_management": {"properties": {"finalized": {"const": true}}}}}},
    {"if": {"properties": {"status": {"const": "WAIT"}}},
     "then": {"required": ["prediction", "change_conditions"]}},
    {"if": {"properties": {"status": {"enum": ["SKIP", "UNAVAILABLE"]}}},
     "then": {"required": ["reason"]}},
    {"if": {"properties": {"status": {"const": "INCOMPLETE"}}},
     "then": {"required": ["missing"]}},
    {"if": {"properties": {"status": {"enum": ["WAIT", "SKIP", "UNAVAILABLE", "INCOMPLETE"]}}},
     "then": {"not": {"anyOf": [{"required": ["risk_management"]}]}}}
  ]
}
