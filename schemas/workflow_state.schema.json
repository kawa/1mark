{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kawa/1mark/schemas/workflow_state.schema.json",
  "title": "User workflow state for one race (separate from prediction status)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "race_id",
    "baseline",
    "state",
    "history",
    "synthetic"
  ],
  "properties": {
    "schema_version": {
      "$ref": "_defs.schema.json#/$defs/semver"
    },
    "race_id": {
      "$ref": "_defs.schema.json#/$defs/race_id"
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prediction_id",
        "prediction_sha256"
      ],
      "properties": {
        "prediction_id": {
          "$ref": "_defs.schema.json#/$defs/id"
        },
        "prediction_sha256": {
          "$ref": "_defs.schema.json#/$defs/sha256"
        }
      },
      "description": "Locked PRE baseline: id and canonical sha256 (onemark.validate.canonical_sha256) of the immutable prediction"
    },
    "state": {
      "enum": [
        "UNDECIDED",
        "PRE_PURCHASED",
        "WAIT_SELECTED",
        "WAIT_SWITCHED_TO_PRE",
        "FINAL_PURCHASED",
        "FINAL_NOT_PURCHASED"
      ],
      "description": "Current user-chosen state; WAIT_SELECTED is a user hold, never an AI prediction status. Purchases are user-reported; no amounts here."
    },
    "history": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "state",
          "at"
        ],
        "properties": {
          "state": {
            "$ref": "#/properties/state"
          },
          "at": {
            "$ref": "_defs.schema.json#/$defs/timestamp"
          },
          "revision_id": {
            "$ref": "_defs.schema.json#/$defs/id"
          },
          "note": {
            "$ref": "_defs.schema.json#/$defs/text"
          }
        }
      }
    },
    "synthetic": {
      "type": "boolean"
    }
  }
}
