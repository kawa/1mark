{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kawa/1mark/schemas/learning_proposal.schema.json",
  "title": "Learning proposal (unvalidated)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "proposal", "source_review_ids", "status", "synthetic"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "id": {"type": "string", "minLength": 1},
    "proposal": {"type": "string", "minLength": 1},
    "source_review_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "status": {"enum": ["proposed", "rejected"]},
    "synthetic": {"type": "boolean"}
  }
}
