{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kawa/1mark/schemas/risk_decision.schema.json",
  "title": "Risk decision: execution gate applied after a prediction is locked",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "risk_decision_id", "prediction_id", "prediction_sha256", "decision", "decided_at", "synthetic"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "risk_decision_id": {"$ref": "_defs.schema.json#/$defs/id"},
    "prediction_id": {"$ref": "_defs.schema.json#/$defs/id"},
    "prediction_sha256": {"$ref": "_defs.schema.json#/$defs/sha256"},
    "decided_at": {"$ref": "_defs.schema.json#/$defs/timestamp"},
    "decision": {"enum": ["approved", "reduced", "rejected"]},
    "unit_value_jpy": {"$ref": "_defs.schema.json#/$defs/stake_jpy"},
    "executions": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["bet_type", "combination", "units", "stake_jpy"],
        "properties": {
          "bet_type": {"$ref": "_defs.schema.json#/$defs/bet_type"},
          "combination": {"$ref": "_defs.schema.json#/$defs/combination"},
          "units": {"$ref": "_defs.schema.json#/$defs/units"},
          "stake_jpy": {"$ref": "_defs.schema.json#/$defs/stake_jpy"}
        }
      }
    },
    "reason": {"$ref": "_defs.schema.json#/$defs/text"},
    "synthetic": {"type": "boolean"}
  },
  "allOf": [
    {"if": {"properties": {"decision": {"enum": ["approved", "reduced"]}}},
     "then": {"required": ["unit_value_jpy", "executions"]}},
    {"if": {"properties": {"decision": {"const": "rejected"}}},
     "then": {"required": ["reason"], "not": {"anyOf": [{"required": ["executions"]}, {"required": ["unit_value_jpy"]}]}}}
  ]
}
